{
  "name": "dsh-usage-deepseek",
  "version": "1.0.1",
  "description": "DSH command plugin: /usage-deepseek command and composer readout for your DeepSeek provider account balance",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "author": "",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "usage",
    "balance",
    "plugin"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-credentials": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jooey/dsh-usage-deepseek.git"
  },
  "bugs": {
    "url": "https://github.com/jooey/dsh-usage-deepseek/issues"
  },
  "homepage": "https://github.com/jooey/dsh-usage-deepseek#readme"
